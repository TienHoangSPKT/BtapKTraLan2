<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="16dp">

    <TextView
            android:id="@+id/tvThongTinSinhVien"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Họ tên: Nguyễn Tiến Hoàng\nMã SV: 2415141122106\nLớp HP: 126TLTTD01"
            android:textSize="16sp"
            android:textStyle="bold" />

    <EditText
            android:id="@+id/edtTenCongViec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Nhập tên công việc"
            android:inputType="text" />

    <EditText
            android:id="@+id/edtMoTa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập mô tả công việc"
            android:inputType="textMultiLine"
            android:minLines="3" />

</LinearLayout>